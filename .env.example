# Google Gemini (server only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Low-latency document and seller-response analysis; a timeout/temporary outage tries the fallback.
GEMINI_ANALYSIS_MODEL=gemini-2.5-flash-lite
GEMINI_ANALYSIS_FALLBACK_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
